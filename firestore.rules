rules_version = '2';
// playerStats/{uid}: uid, nickname (1–20 chars), six numeric wins, totalWins, updatedAt.
// gameResults/{matchId}: immutable matchId, gameId, winners (max 12), completedAt.
// Both are exclusively accessed by the Admin SDK in authenticated Cloud Functions.
// No client write operation is allowed, including owners modifying their own wins.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
